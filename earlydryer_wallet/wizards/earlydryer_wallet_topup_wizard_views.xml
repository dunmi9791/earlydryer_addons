<odoo>
    <record id="earlydryer_wallet_topup_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wallet.topup.wizard.form</field>
        <field name="model">earlydryer.wallet.topup.wizard</field>
        <field name="arch" type="xml">
            <form string="Top Up Wallet">
                <group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="balance"/>
                        <field name="amount"/>
                        <field name="min_amount" invisible="min_amount == 0"/>
                    </group>
                    <group>
                        <field name="earlydryer_branch_id" options="{'no_create': True}"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="reference"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Top Up" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="earlydryer_wallet_topup_wizard_action" model="ir.actions.act_window">
        <field name="name">Top Up Wallet</field>
        <field name="res_model">earlydryer.wallet.topup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
