<odoo>
    <record id="earlydryer_wallet_spend_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wallet.spend.wizard.form</field>
        <field name="model">earlydryer.wallet.spend.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay from Wallet">
                <group>
                    <group>
                        <field name="invoice_id" invisible="not invoice_id"/>
                        <field name="laundry_job_id" invisible="not laundry_job_id"/>
                        <field name="partner_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="due"/>
                        <field name="balance"/>
                        <field name="amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Pay" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
