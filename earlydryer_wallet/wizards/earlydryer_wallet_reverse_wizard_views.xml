<odoo>
    <record id="earlydryer_wallet_reverse_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wallet.reverse.wizard.form</field>
        <field name="model">earlydryer.wallet.reverse.wizard</field>
        <field name="arch" type="xml">
            <form string="Reverse Wallet Transaction">
                <p class="text-muted">
                    Posted transactions are never edited: the reversal posts the
                    reversal entry of the original and restores the balance.
                </p>
                <group>
                    <field name="transaction_id"/>
                </group>
                <field name="reason" placeholder="Reason of the reversal"/>
                <footer>
                    <button name="action_confirm" type="object" string="Reverse" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
