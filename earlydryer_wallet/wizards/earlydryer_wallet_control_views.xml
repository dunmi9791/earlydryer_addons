<odoo>
    <record id="earlydryer_wallet_control_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wallet.control.form</field>
        <field name="model">earlydryer.wallet.control</field>
        <field name="arch" type="xml">
            <form string="Wallet Control" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Wallet Control</h1>
                        <p class="text-muted">
                            The wallet ledger is the subledger of record. Its total must
                            equal the credit balance of the Customer Advances account.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="account_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="wallet_total"/>
                            <field name="gl_balance"/>
                            <field name="difference" class="fw-bold"
                                   decoration-success="difference == 0" decoration-danger="difference != 0"/>
                            <field name="pending_amount"/>
                            <field name="unexplained" class="fw-bold"
                                   decoration-success="unexplained == 0" decoration-danger="unexplained != 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Till Transactions not Accounted Yet" name="pending">
                            <field name="pending_transaction_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="type"/>
                                    <field name="pos_order_id"/>
                                    <field name="pos_session_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="signed_amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Overdrawn Wallets" name="overdrawn">
                            <field name="overdrawn_wallet_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="partner_phone"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="balance"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
