<odoo>
    <!-- Wallets are usable at every plant: no branch rule, only the company -->
    <record id="earlydryer_wallet_rule_company" model="ir.rule">
        <field name="name">Earlydryer wallet: multi-company</field>
        <field name="model_id" ref="model_earlydryer_wallet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="earlydryer_wallet_transaction_rule_company" model="ir.rule">
        <field name="name">Earlydryer wallet transaction: multi-company</field>
        <field name="model_id" ref="model_earlydryer_wallet_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
