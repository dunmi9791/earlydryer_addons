<odoo>
    <record id="earlydryer_wallet_control_server_action" model="ir.actions.server">
        <field name="name">Wallet Control</field>
        <field name="model_id" ref="model_earlydryer_wallet_control"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
        <field name="group_ids" eval="[(4, ref('earlydryer_base.group_finance'))]"/>
    </record>

    <menuitem id="menu_earlydryer_wallet" name="Wallets"
              parent="earlydryer_base.menu_earlydryer_root" sequence="30"/>
    <menuitem id="menu_earlydryer_wallet_balances" parent="menu_earlydryer_wallet"
              action="earlydryer_wallet_action" sequence="10"/>
    <menuitem id="menu_earlydryer_wallet_transactions" name="Transactions"
              parent="menu_earlydryer_wallet" action="earlydryer_wallet_transaction_action"
              sequence="20"/>
    <menuitem id="menu_earlydryer_wallet_control" parent="menu_earlydryer_wallet"
              action="earlydryer_wallet_control_server_action" sequence="30"
              groups="earlydryer_base.group_finance"/>
    <menuitem id="menu_earlydryer_wallet_import" parent="menu_earlydryer_wallet"
              action="earlydryer_wallet_import_wizard_action" sequence="40"
              groups="earlydryer_base.group_finance"/>
</odoo>
