<odoo>
    <record id="view_pos_pos_form_earlydryer_wallet" model="ir.ui.view">
        <field name="name">pos.order.form.earlydryer.wallet</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_earlydryer_wallet_retry" type="object" string="Retry Wallet Sync"
                        invisible="not earlydryer_wallet_error"
                        groups="earlydryer_base.group_finance,earlydryer_base.group_branch_manager"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not earlydryer_wallet_error">
                    <strong>Wallet transactions not recorded.</strong>
                    <field name="earlydryer_wallet_error" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='extra']" position="before">
                <page string="Wallet" name="earlydryer_wallet"
                      invisible="not earlydryer_wallet_transaction_ids">
                    <field name="earlydryer_wallet_transaction_ids" readonly="1"
                           context="{'list_view_ref': 'earlydryer_wallet.earlydryer_wallet_transaction_view_list'}"/>
                    <group>
                        <field name="earlydryer_wallet_balance_after"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
