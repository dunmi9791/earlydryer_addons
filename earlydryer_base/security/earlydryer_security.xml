<odoo>
    <!--
        One "Earlydryer" section on the user form (category from the manifest).
        Odoo 19 renders each privilege as ONE dropdown, so the roles are split
        over several privileges to let a user hold two roles (e.g. Front Desk
        and Rider).
    -->
    <record id="privilege_earlydryer_operations" model="res.groups.privilege">
        <field name="name">Earlydryer Operations</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_earlydryer"/>
    </record>
    <record id="privilege_earlydryer_customer_service" model="res.groups.privilege">
        <field name="name">Earlydryer Customer Service</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_earlydryer"/>
    </record>
    <record id="privilege_earlydryer_logistics" model="res.groups.privilege">
        <field name="name">Earlydryer Logistics</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_earlydryer"/>
    </record>
    <record id="privilege_earlydryer_finance" model="res.groups.privilege">
        <field name="name">Earlydryer Finance</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_earlydryer"/>
    </record>
    <record id="privilege_earlydryer_hr" model="res.groups.privilege">
        <field name="name">Earlydryer HR</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_earlydryer"/>
    </record>
    <record id="privilege_earlydryer_management" model="res.groups.privilege">
        <field name="name">Earlydryer Management</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_earlydryer"/>
    </record>

    <!-- Technical: lifts the branch restriction of the record rules -->
    <record id="group_all_branches" model="res.groups">
        <field name="name">Earlydryer: See all branches</field>
        <field name="comment">Technical group: read and work on every branch.</field>
    </record>

    <record id="group_production" model="res.groups">
        <field name="name">Production Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_earlydryer_operations"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Processes garments in the plant; reads data of their branch only.</field>
    </record>
    <record id="group_qc" model="res.groups">
        <field name="name">Quality Control</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_earlydryer_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_production'))]"/>
        <field name="comment">Production Staff who also pass or fail quality checks.</field>
    </record>
    <record id="group_front_desk" model="res.groups">
        <field name="name">Front Desk</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_earlydryer_operations"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('point_of_sale.group_pos_user')),
            (4, ref('stock.group_stock_user')),
        ]"/>
        <field name="comment">Creates orders and takes payments; cannot change prices or approve discounts or credit.</field>
    </record>
    <record id="group_customer_service" model="res.groups">
        <field name="name">Customer Service</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_earlydryer_customer_service"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rider" model="res.groups">
        <field name="name">Rider</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_earlydryer_logistics"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Pickup and delivery; reads data of their branch only.</field>
    </record>
    <record id="group_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_earlydryer_operations"/>
        <field name="implied_ids" eval="[
            (4, ref('group_front_desk')),
            (4, ref('group_qc')),
            (4, ref('group_customer_service')),
            (4, ref('group_rider')),
            (4, ref('point_of_sale.group_pos_manager')),
        ]"/>
        <field name="comment">Runs one or more plants: shelves, staff and approvals of their branches.</field>
    </record>
    <record id="group_operations_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_earlydryer_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_branch_manager')), (4, ref('group_all_branches'))]"/>
        <field name="comment">Branch Manager rights on every branch.</field>
    </record>
    <record id="group_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_earlydryer_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_all_branches')), (4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="group_hr" model="res.groups">
        <field name="name">HR</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_earlydryer_hr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_all_branches'))]"/>
    </record>
    <record id="group_management" model="res.groups">
        <field name="name">Management</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_earlydryer_management"/>
        <field name="implied_ids" eval="[(4, ref('group_operations_manager')), (4, ref('group_finance')), (4, ref('group_hr'))]"/>
        <field name="comment">Operations, Finance and HR on all branches; manages approval rules.</field>
    </record>
    <record id="group_admin" model="res.groups">
        <field name="name">Earlydryer Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_earlydryer_management"/>
        <field name="implied_ids" eval="[(4, ref('group_management')), (4, ref('base.group_system'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full Earlydryer configuration, including branches. Also Odoo Settings.</field>
    </record>
</odoo>
