<odoo>
    <record id="res_config_settings_view_form_earlydryer" model="ir.ui.view">
        <field name="name">res.config.settings.form.earlydryer.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="before">
                <block title="Earlydryer" id="earlydryer_pos_section">
                    <setting id="earlydryer_branch_setting" string="Earlydryer Branch"
                             help="Plant this point of sale belongs to.">
                        <field name="pos_earlydryer_branch_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
