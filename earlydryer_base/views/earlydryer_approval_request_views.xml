<odoo>
    <record id="earlydryer_approval_request_view_list" model="ir.ui.view">
        <field name="name">earlydryer.approval.request.list</field>
        <field name="model">earlydryer.approval.request</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'pending'" decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="requested_on"/>
                <field name="approval_type"/>
                <field name="res_name"/>
                <field name="value"/>
                <field name="threshold_kind" optional="hide"/>
                <field name="earlydryer_branch_id" optional="show"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="approver_group_id" optional="show"/>
                <field name="decided_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                       decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_approval_request_view_form" model="ir.ui.view">
        <field name="name">earlydryer.approval.request.form</field>
        <field name="model">earlydryer.approval.request</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'pending' or not can_decide"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending' or not can_decide"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_document" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Document</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="approval_type"/>
                            <field name="res_name"/>
                            <field name="value"/>
                            <field name="threshold_kind"/>
                            <field name="earlydryer_branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="rule_id"/>
                            <field name="approver_group_id"/>
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="requested_on"/>
                            <field name="decided_by_id" widget="many2one_avatar_user" invisible="not decided_by_id"/>
                            <field name="decided_on" invisible="not decided_on"/>
                            <field name="can_decide" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="1"/>
                        <field name="decision_note" readonly="state != 'pending' or not can_decide"
                               placeholder="Optional note for the requester"/>
                        <field name="approver_user_ids" widget="many2many_tags_avatar"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="earlydryer_approval_request_view_search" model="ir.ui.view">
        <field name="name">earlydryer.approval.request.search</field>
        <field name="model">earlydryer.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requested_by_id"/>
                <field name="earlydryer_branch_id"/>
                <field name="rule_id"/>
                <filter string="To Approve by Me" name="to_approve" domain="[('state', '=', 'pending'), ('can_decide', '=', True)]"/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by_id', '=', uid)]"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Requested On" name="requested_on" date="requested_on"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'approval_type'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'earlydryer_branch_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="earlydryer_approval_request_action_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">earlydryer.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p>
        </field>
    </record>
    <record id="earlydryer_approval_request_action_mine" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">earlydryer.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You have not requested any approval yet</p>
            <p>Approvals are requested from documents (orders, claims...) when a limit is exceeded.</p>
        </field>
    </record>
    <record id="earlydryer_approval_request_action_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">earlydryer.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
