<odoo>
    <record id="earlydryer_approval_rule_view_list" model="ir.ui.view">
        <field name="name">earlydryer.approval.rule.list</field>
        <field name="model">earlydryer.approval.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approval_type"/>
                <field name="model_id"/>
                <field name="threshold_kind"/>
                <field name="min_value"/>
                <field name="max_value"/>
                <field name="approver_group_id"/>
                <field name="self_approve"/>
                <field name="branch_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_approval_rule_view_form" model="ir.ui.view">
        <field name="name">earlydryer.approval.rule.form</field>
        <field name="model">earlydryer.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Discount above 5%"/></h1>
                    </div>
                    <group>
                        <group string="Applies to">
                            <field name="approval_type"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="branch_ids" widget="many2many_tags" placeholder="All branches"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Threshold">
                            <field name="threshold_kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                        </group>
                        <group string="Approval">
                            <field name="approver_group_id" options="{'no_create': True}"/>
                            <field name="self_approve"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="earlydryer_approval_rule_view_search" model="ir.ui.view">
        <field name="name">earlydryer.approval.rule.search</field>
        <field name="model">earlydryer.approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <field name="approver_group_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'approval_type'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="earlydryer_approval_rule_action" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">earlydryer.approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define who approves what</p>
            <p>For example: discounts up to 5% approved by a Branch Manager, above 5% by Management.</p>
        </field>
    </record>
</odoo>
