<odoo>
    <record id="earlydryer_approval_request_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.approval.request.wizard.form</field>
        <field name="model">earlydryer.approval.request.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1" force_save="1"/>
                <field name="res_id" invisible="1" force_save="1"/>
                <group>
                    <field name="approval_type" force_save="1"/>
                    <field name="value" force_save="1"/>
                    <field name="reason" placeholder="Why is this needed?"/>
                </group>
                <footer>
                    <button name="action_request" type="object" string="Request Approval" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
