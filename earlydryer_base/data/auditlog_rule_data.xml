<odoo noupdate="1">
    <!-- confirmed (subscribed) by the post_init_hook, see hooks.py -->
    <record id="auditlog_rule_earlydryer_branch" model="auditlog.rule">
        <field name="name">Earlydryer branches</field>
        <field name="model_id" ref="model_earlydryer_branch"/>
        <field name="log_type">full</field>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="log_read" eval="False"/>
        <field name="log_export_data" eval="False"/>
        <field name="capture_record" eval="True"/>
    </record>
    <record id="auditlog_rule_earlydryer_approval_rule" model="auditlog.rule">
        <field name="name">Earlydryer approval rules</field>
        <field name="model_id" ref="model_earlydryer_approval_rule"/>
        <field name="log_type">full</field>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="log_read" eval="False"/>
        <field name="log_export_data" eval="False"/>
        <field name="capture_record" eval="True"/>
    </record>
    <record id="auditlog_rule_earlydryer_approval_request" model="auditlog.rule">
        <field name="name">Earlydryer approval requests</field>
        <field name="model_id" ref="model_earlydryer_approval_request"/>
        <field name="log_type">full</field>
        <field name="log_create" eval="True"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="log_read" eval="False"/>
        <field name="log_export_data" eval="False"/>
        <field name="capture_record" eval="True"/>
    </record>
</odoo>
