<odoo>
    <record id="product_template_form_view_earlydryer_accounting" model="ir.ui.view">
        <field name="name">product.template.form.earlydryer.accounting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="earlydryer_service_catalog.product_template_form_view_earlydryer"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='earlydryer']" position="inside">
                <field name="earlydryer_service_line_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="product_category_form_view_earlydryer_accounting" model="ir.ui.view">
        <field name="name">product.category.form.earlydryer.accounting</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="earlydryer_service_line_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
