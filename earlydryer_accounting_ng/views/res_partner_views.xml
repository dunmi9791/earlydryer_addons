<odoo>
    <record id="view_partner_property_form_earlydryer_wht" model="ir.ui.view">
        <field name="name">res.partner.form.earlydryer.wht</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_supplier_payment_term_id']" position="after">
                <field name="earlydryer_wht_category_id" options="{'no_create': True}"
                       groups="account.group_account_invoice,account.group_account_readonly"/>
                <field name="earlydryer_wht_vendor_type"
                       invisible="not earlydryer_wht_category_id"
                       groups="account.group_account_invoice,account.group_account_readonly"/>
            </xpath>
        </field>
    </record>
</odoo>
