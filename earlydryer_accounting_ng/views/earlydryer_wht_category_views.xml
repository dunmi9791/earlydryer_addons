<odoo>
    <record id="earlydryer_wht_category_view_list" model="ir.ui.view">
        <field name="name">earlydryer.wht.category.list</field>
        <field name="model">earlydryer.wht.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="rate_company_vendor"/>
                <field name="rate_individual_vendor"/>
                <field name="tax_company_id" optional="show"/>
                <field name="tax_individual_id" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="earlydryer_wht_category_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wht.category.form</field>
        <field name="model">earlydryer.wht.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Rates (placeholders: confirm with the tax adviser)">
                            <field name="rate_company_vendor"/>
                            <field name="rate_individual_vendor"/>
                        </group>
                        <group string="Taxes">
                            <field name="tax_company_id"/>
                            <field name="tax_individual_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="earlydryer_wht_category_action" model="ir.actions.act_window">
        <field name="name">WHT Categories</field>
        <field name="res_model">earlydryer.wht.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
