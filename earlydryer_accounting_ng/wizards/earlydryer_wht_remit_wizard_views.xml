<odoo>
    <record id="earlydryer_wht_remit_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wht.remit.wizard.form</field>
        <field name="model">earlydryer.wht.remit.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark WHT Remitted">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="reference"/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                        <field name="amount"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="date"/>
                        <field name="move_id"/>
                        <field name="partner_id"/>
                        <field name="name"/>
                        <field name="balance" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_remit" string="Pay and Reconcile" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
