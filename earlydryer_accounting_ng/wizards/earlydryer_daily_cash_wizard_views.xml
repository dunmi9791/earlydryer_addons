<odoo>
    <record id="earlydryer_daily_cash_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.daily.cash.wizard.form</field>
        <field name="model">earlydryer.daily.cash.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Cash Report">
                <group>
                    <field name="branch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="earlydryer_daily_cash_wizard_action" model="ir.actions.act_window">
        <field name="name">Daily Cash Report</field>
        <field name="res_model">earlydryer.daily.cash.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
