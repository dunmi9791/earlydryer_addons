<odoo>
    <record id="earlydryer_rider_handover_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.rider.handover.wizard.form</field>
        <field name="model">earlydryer.rider.handover.wizard</field>
        <field name="arch" type="xml">
            <form string="Rider Cash Handover">
                <group>
                    <group>
                        <field name="branch_id" options="{'no_create': True}"/>
                        <field name="rider_id" options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="reference"/>
                    </group>
                </group>
                <footer>
                    <button name="action_handover" string="Post Handover" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="earlydryer_rider_handover_wizard_action" model="ir.actions.act_window">
        <field name="name">Rider Cash Handover</field>
        <field name="res_model">earlydryer.rider.handover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
