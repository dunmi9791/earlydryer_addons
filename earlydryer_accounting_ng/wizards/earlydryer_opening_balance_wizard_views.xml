<odoo>
    <record id="earlydryer_opening_balance_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.opening.balance.wizard.form</field>
        <field name="model">earlydryer.opening.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Opening Balances">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'upload'">
                    CSV or XLSX trial balance with the columns account_code,
                    account_name (check only), debit, credit, partner_ref (receivable
                    and payable lines: phone, reference or exact name), plant_code,
                    label and date_maturity (optional). Customer advances rows are
                    refused: wallet balances come in through the wallet import.
                </div>
                <group invisible="state != 'upload'">
                    <field name="date"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <div invisible="state == 'upload'">
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="difference"/>
                            <field name="confirm_difference" invisible="not difference or state != 'preview'"/>
                        </group>
                        <group>
                            <field name="error_count"/>
                            <field name="advances_tb_amount"/>
                            <field name="advances_wallet_amount"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list decoration-danger="status != 'ok'">
                            <field name="row"/>
                            <field name="account_code"/>
                            <field name="account_id"/>
                            <field name="partner_ref" optional="hide"/>
                            <field name="partner_id"/>
                            <field name="branch_id" optional="show"/>
                            <field name="label" optional="hide"/>
                            <field name="date_maturity" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="debit" sum="Debit"/>
                            <field name="credit" sum="Credit"/>
                            <field name="status"/>
                            <field name="message"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_preview" string="Dry Run" type="object" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_import" string="Post Opening Entry" type="object" class="btn-primary"
                            invisible="state != 'preview' or error_count"/>
                    <button name="action_back" string="Back" type="object" invisible="state != 'preview'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="earlydryer_opening_balance_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Opening Balances</field>
        <field name="res_model">earlydryer.opening.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
