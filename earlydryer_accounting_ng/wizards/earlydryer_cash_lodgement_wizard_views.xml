<odoo>
    <record id="earlydryer_cash_lodgement_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.cash.lodgement.wizard.form</field>
        <field name="model">earlydryer.cash.lodgement.wizard</field>
        <field name="arch" type="xml">
            <form string="Cash Lodgement">
                <group>
                    <group>
                        <field name="branch_id" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="cash_journal_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="cash_balance"/>
                    </group>
                    <group>
                        <field name="float_amount"/>
                        <field name="amount"/>
                        <field name="bank_journal_id" options="{'no_create': True}"/>
                        <field name="reference"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not below_float">
                    This leaves less than the plant's float in the till: a Branch
                    Manager of the plant (or Management) must lodge it.
                </div>
                <field name="below_float" invisible="1"/>
                <footer>
                    <button name="action_lodge" string="Post Lodgement" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="earlydryer_cash_lodgement_wizard_action" model="ir.actions.act_window">
        <field name="name">Cash Lodgement</field>
        <field name="res_model">earlydryer.cash.lodgement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
