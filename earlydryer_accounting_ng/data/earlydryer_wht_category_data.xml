<odoo noupdate="1">
    <!-- PLACEHOLDER RATES: every rate below must be confirmed by Earlydryer's
         tax adviser against the current Nigerian WHT rules before go-live.
         The taxes are generated by the accounting setup wizard. -->
    <record id="wht_category_professional" model="earlydryer.wht.category">
        <field name="name">Professional / consultancy services</field>
        <field name="code">PROF</field>
        <field name="sequence">10</field>
        <field name="rate_company_vendor">10</field>
        <field name="rate_individual_vendor">5</field>
    </record>
    <record id="wht_category_technical" model="earlydryer.wht.category">
        <field name="name">Technical / management services</field>
        <field name="code">TECH</field>
        <field name="sequence">20</field>
        <field name="rate_company_vendor">10</field>
        <field name="rate_individual_vendor">5</field>
    </record>
    <record id="wht_category_rent" model="earlydryer.wht.category">
        <field name="name">Rent</field>
        <field name="code">RENT</field>
        <field name="sequence">30</field>
        <field name="rate_company_vendor">10</field>
        <field name="rate_individual_vendor">10</field>
    </record>
    <record id="wht_category_construction" model="earlydryer.wht.category">
        <field name="name">Construction / contracts</field>
        <field name="code">CONTR</field>
        <field name="sequence">40</field>
        <field name="rate_company_vendor">5</field>
        <field name="rate_individual_vendor">5</field>
    </record>
    <record id="wht_category_commission" model="earlydryer.wht.category">
        <field name="name">Commission</field>
        <field name="code">COMM</field>
        <field name="sequence">50</field>
        <field name="rate_company_vendor">10</field>
        <field name="rate_individual_vendor">5</field>
    </record>
    <record id="wht_category_goods" model="earlydryer.wht.category">
        <field name="name">Supply of goods</field>
        <field name="code">GOODS</field>
        <field name="sequence">60</field>
        <field name="rate_company_vendor">5</field>
        <field name="rate_individual_vendor">5</field>
        <field name="active" eval="False"/>
        <field name="note">Often exempt in the ordinary course of business: inactive until the tax adviser confirms.</field>
    </record>
</odoo>
