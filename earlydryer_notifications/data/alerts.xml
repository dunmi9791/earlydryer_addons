<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="rule_alert_overdue" model="earlydryer.notify.alert.rule">
    <field name="name">Overdue orders</field>
    <field name="event_id" ref="event_alert_overdue" />
    <field name="mode">digest</field>
    <field name="threshold">0</field>
    <field name="recipient_group_ids" eval="[(6,0,[ref('earlydryer_base.group_branch_manager')])]" />
  </record>
  <record id="rule_alert_large_discount" model="earlydryer.notify.alert.rule">
