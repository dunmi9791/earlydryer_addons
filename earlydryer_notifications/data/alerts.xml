    <field name="recipient_group_ids" eval="[(6,0,[ref('earlydryer_base.group_branch_manager'),ref('earlydryer_base.group_finance')])]" />
  </record>
  <record id="rule_alert_scan_mismatch" model="earlydryer.notify.alert.rule">
