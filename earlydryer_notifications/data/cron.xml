<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="cron_retention" model="ir.cron">
    <field name="name">Notification retention</field>
    <field name="model_id" ref="model_earlydryer_notify_message" />
    <field name="state">code</field>
    <field name="code">model._cron_retention()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True" />
  </record>
  <record id="cron_digest" model="ir.cron">
    <field name="name">Notification digests</field>
    <field name="model_id" ref="model_earlydryer_notify_alert_rule" />
    <field name="state">code</field>
    <field name="code">model._cron_digest()</field>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True" />
  </record>
  <record id="cron_eod" model="ir.cron">
    <field name="name">End of day reports</field>
    <field name="model_id" ref="earlydryer_base.model_earlydryer_branch" />
    <field name="state">code</field>
    <field name="code">model._cron_eod()</field>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True" />
  </record>
</odoo>
