<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_notify_service" model="res.groups">
    <field name="name">Notification webhook service</field>
  </record>
  <record id="user_notify_service" model="res.users">
    <field name="name">Notification webhook service</field>
    <field name="login">__earlydryer_notify_service__</field>
    <field name="group_ids" eval="[(6,0,[ref('base.group_user'),ref('group_notify_service')])]" />
  </record>
  <record id="rule_message_company" model="ir.rule">
    <field name="name">Notifications: company</field>
    <field name="model_id" ref="model_earlydryer_notify_message" />
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>
  <record id="rule_message_branch" model="ir.rule">
    <field name="name">Notifications: allowed plants</field>
    <field name="model_id" ref="model_earlydryer_notify_message" />
    <field name="domain_force">[('earlydryer_branch_id','in',earlydryer_branch_ids)]</field>
    <field name="groups" eval="[(4,ref('base.group_user'))]" />
  </record>
  <record id="rule_message_all" model="ir.rule">
    <field name="name">Notifications: all plants</field>
    <field name="model_id" ref="model_earlydryer_notify_message" />
    <field name="domain_force">[(1,"=",1)]</field>
    <field name="groups" eval="[(4,ref('earlydryer_base.group_all_branches'))]" />
  </record>
  <record id="rule_inbound_company" model="ir.rule">
    <field name="name">Notifications: company</field>
    <field name="model_id" ref="model_earlydryer_notify_inbound" />
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>
  <record id="rule_inbound_branch" model="ir.rule">
    <field name="name">Notifications: allowed plants</field>
    <field name="model_id" ref="model_earlydryer_notify_inbound" />
    <field name="domain_force">[('earlydryer_branch_id','in',earlydryer_branch_ids)]</field>
    <field name="groups" eval="[(4,ref('base.group_user'))]" />
  </record>
  <record id="rule_inbound_all" model="ir.rule">
    <field name="name">Notifications: all plants</field>
    <field name="model_id" ref="model_earlydryer_notify_inbound" />
    <field name="domain_force">[(1,"=",1)]</field>
    <field name="groups" eval="[(4,ref('earlydryer_base.group_all_branches'))]" />
  </record>
  <record id="rule_inbound_unassigned" model="ir.rule">
    <field name="name">Customer service: own plants and unmatched messages</field>
    <field name="model_id" ref="model_earlydryer_notify_inbound" />
    <field name="domain_force">['|',('earlydryer_branch_id','=',False),('earlydryer_branch_id','in',earlydryer_branch_ids)]</field>
    <field name="groups" eval="[(4,ref('earlydryer_base.group_customer_service'))]" />
  </record>
  <record id="rule_provider_company" model="ir.rule">
    <field name="name">Provider company</field>
    <field name="model_id" ref="model_earlydryer_notify_provider" />
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>
</odoo>
