<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="earlydryer_notifications.CustomerConsent" t-inherit="earlydryer_pos.EdCustomerDialog" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class,'ed-customer-create')]" position="inside">
            <label class="form-check"><input type="checkbox" class="form-check-input" t-model="state.notifyConsent"/> Send order and payment updates by WhatsApp/SMS. Reply STOP to stop.</label>
        </xpath>
    </t>
</templates>
