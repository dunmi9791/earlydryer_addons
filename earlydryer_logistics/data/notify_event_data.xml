<!-- Events and DRAFT templates added to earlydryer_notifications, following
     its README: submit the WhatsApp templates to Meta before activating. -->
<odoo noupdate="1">
  <record id="event_delivery_scheduled" model="earlydryer.notify.event">
    <field name="name">Delivery scheduled</field>
    <field name="code">delivery_scheduled</field>
    <field name="audience">customer</field>
    <field name="active" eval="True" />
    <field name="urgent" eval="False" />
    <field name="allow_repeat" eval="False" />
  </record>
  <record id="template_delivery_scheduled_whatsapp" model="earlydryer.notify.template">
    <field name="name">Delivery scheduled (whatsapp)</field>
    <field name="event_id" ref="event_delivery_scheduled" />
    <field name="channel">whatsapp</field>
    <field name="body">{{ ctx['plant'] }}: Order {{ ctx['number'] }} will be delivered {{ ctx['slot'] }}. Delivery fee {{ ctx['fee'] }}. To pay on delivery {{ ctx['cod'] }}. Call {{ ctx['plant_phone'] }}.</field>
    <field name="approved" eval="False" />
    <field name="meta_template_name">earlydryer_delivery_scheduled</field>
    <field name="meta_language">en</field>
    <field name="param_expressions">["ctx['plant']", "ctx['number']", "ctx['slot']", "ctx['fee']", "ctx['cod']", "ctx['plant_phone']"]</field>
  </record>
  <record id="template_delivery_scheduled_sms" model="earlydryer.notify.template">
    <field name="name">Delivery scheduled (sms)</field>
    <field name="event_id" ref="event_delivery_scheduled" />
    <field name="channel">sms</field>
    <field name="body">{{ ctx['plant'] }}: Order {{ ctx['number'] }} will be delivered {{ ctx['slot'] }}. Delivery fee {{ ctx['fee'] }}. To pay on delivery {{ ctx['cod'] }}. Call {{ ctx['plant_phone'] }}.</field>
    <field name="approved" eval="False" />
    <field name="meta_template_name" />
    <field name="meta_language">en</field>
    <field name="param_expressions">["ctx['plant']", "ctx['number']", "ctx['slot']", "ctx['fee']", "ctx['cod']", "ctx['plant_phone']"]</field>
  </record>
  <record id="event_delivery_failed" model="earlydryer.notify.event">
    <field name="name">Delivery failed (customer)</field>
    <field name="code">delivery_failed</field>
    <field name="audience">customer</field>
    <field name="active" eval="True" />
    <field name="urgent" eval="True" />
    <field name="allow_repeat" eval="True" />
  </record>
  <record id="template_delivery_failed_whatsapp" model="earlydryer.notify.template">
    <field name="name">Delivery failed (customer) (whatsapp)</field>
    <field name="event_id" ref="event_delivery_failed" />
    <field name="channel">whatsapp</field>
    <field name="body">{{ ctx['plant'] }}: We could not deliver order {{ ctx['number'] }} ({{ ctx['summary'] }}). We will call you to arrange another time. Call {{ ctx['plant_phone'] }}.</field>
    <field name="approved" eval="False" />
    <field name="meta_template_name">earlydryer_delivery_failed</field>
    <field name="meta_language">en</field>
    <field name="param_expressions">["ctx['plant']", "ctx['number']", "ctx['summary']", "ctx['plant_phone']"]</field>
  </record>
  <record id="template_delivery_failed_sms" model="earlydryer.notify.template">
    <field name="name">Delivery failed (customer) (sms)</field>
    <field name="event_id" ref="event_delivery_failed" />
    <field name="channel">sms</field>
    <field name="body">{{ ctx['plant'] }}: We could not deliver order {{ ctx['number'] }} ({{ ctx['summary'] }}). We will call you to arrange another time. Call {{ ctx['plant_phone'] }}.</field>
    <field name="approved" eval="False" />
    <field name="meta_template_name" />
    <field name="meta_language">en</field>
    <field name="param_expressions">["ctx['plant']", "ctx['number']", "ctx['summary']", "ctx['plant_phone']"]</field>
  </record>
  <record id="event_alert_rider_cash_short" model="earlydryer.notify.event">
    <field name="name">Rider cash short</field>
    <field name="code">alert_rider_cash_short</field>
    <field name="audience">staff</field>
    <field name="active" eval="True" />
    <field name="urgent" eval="False" />
    <field name="allow_repeat" eval="True" />
  </record>
  <record id="template_alert_rider_cash_short_whatsapp" model="earlydryer.notify.template">
    <field name="name">Rider cash short (whatsapp)</field>
    <field name="event_id" ref="event_alert_rider_cash_short" />
    <field name="channel">whatsapp</field>
    <field name="body">{{ ctx['plant'] }}: Rider cash short {{ ctx['number'] }}: {{ ctx['summary'] }}. Call {{ ctx['plant_phone'] }}.</field>
    <field name="approved" eval="False" />
    <field name="meta_template_name">earlydryer_alert_rider_cash_short</field>
    <field name="meta_language">en</field>
    <field name="param_expressions">["ctx['plant']", "ctx['number']", "ctx['summary']", "ctx['plant_phone']"]</field>
  </record>
  <record id="template_alert_rider_cash_short_sms" model="earlydryer.notify.template">
    <field name="name">Rider cash short (sms)</field>
    <field name="event_id" ref="event_alert_rider_cash_short" />
    <field name="channel">sms</field>
    <field name="body">{{ ctx['plant'] }}: Rider cash short {{ ctx['number'] }}: {{ ctx['summary'] }}. Call {{ ctx['plant_phone'] }}.</field>
    <field name="approved" eval="False" />
    <field name="meta_template_name" />
    <field name="meta_language">en</field>
    <field name="param_expressions">["ctx['plant']", "ctx['number']", "ctx['summary']", "ctx['plant_phone']"]</field>
  </record>
</odoo>
