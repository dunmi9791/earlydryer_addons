<odoo>
    <record id="view_employee_form_earlydryer_logistics" model="ir.ui.view">
        <field name="name">hr.employee.form.earlydryer.logistics</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='earlydryer_branch_id']" position="after">
                <field name="earlydryer_is_rider"/>
            </xpath>
        </field>
    </record>
</odoo>
