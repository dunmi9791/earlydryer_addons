<odoo>
    <record id="earlydryer_fail_reason_view_list" model="ir.ui.view">
        <field name="name">earlydryer.logistics.fail.reason.list</field>
        <field name="model">earlydryer.logistics.fail.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="stop_type"/>
                <field name="fee_applies"/>
                <field name="note_required"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="earlydryer_fail_reason_action" model="ir.actions.act_window">
        <field name="name">Failure Reasons</field>
        <field name="res_model">earlydryer.logistics.fail.reason</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
