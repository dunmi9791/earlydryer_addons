<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="earlydryer_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]/div[1]" position="inside">
            <button t-if="pos.edEnabled and currentOrder.edIsLaundry" class="button btn btn-lg btn-secondary w-100 py-3 ed-reprint-tags" t-on-click="edReprintTags">
                <i class="fa fa-tags me-1"/>Reprint Tags
            </button>
        </xpath>
    </t>
    <t t-name="earlydryer_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button t-if="pos.edEnabled and _selectedSyncedOrder?.edIsLaundry" class="control-button btn btn-secondary btn-lg lh-lg flex-grow-1 flex-shrink-1 ed-reprint-tags" t-on-click="() => this.edReprintTags(_selectedSyncedOrder)">
                <i class="fa fa-tags me-1"/>Tags
            </button>
        </xpath>
    </t>
</templates>
