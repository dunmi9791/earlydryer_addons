<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="earlydryer_pos.EdCollectionScreen">
        <div class="ed-collection-screen screen h-100 d-flex flex-column bg-view p-3 gap-3 overflow-auto">
            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-lg" t-on-click="back">
                    <i class="fa fa-arrow-left"/>
                </button>
                <input t-ref="input" class="form-control form-control-lg ed-collect-query" t-model="state.query" placeholder="Scan receipt or tag, or type phone / job number" t-on-keydown="(ev) => ev.key === 'Enter' and this.lookup()"/>
                <button class="btn btn-primary btn-lg ed-collect-search" t-on-click="lookup">
                    <i t-attf-class="fa {{state.searching ? 'fa-spin fa-circle-o-notch' : 'fa-search'}}"/>
                </button>
                <span t-if="!pos.edOnline" class="badge text-bg-warning align-self-center">Offline</span>
            </div>
            <div t-if="state.message" class="alert alert-warning m-0" t-esc="state.message"/>
            <div t-if="!job and state.jobs.length" class="list-group">
                <button t-foreach="state.jobs" t-as="item" t-key="item.id" class="list-group-item list-group-item-action d-flex justify-content-between py-3 ed-collect-result" t-on-click="() => this.open(item)">
                    <span>
                        <b t-esc="item.name"/> · <t t-esc="item.partner_name"/>
                    </span>
                    <span>
                        <t t-esc="item.state_label"/> · <t t-esc="item.shelf"/>
                    </span>
                </button>
            </div>
            <div t-if="job" class="card ed-collect-job">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fs-3 fw-bold" t-esc="job.name"/>
                            <div class="fs-5">
                                <t t-esc="job.partner_name"/> · <t t-esc="job.partner_phone"/>
                            </div>
                            <div>
                                <t t-esc="job.item_count"/> item(s) · <span class="badge text-bg-info ed-collect-state" t-esc="job.state_label"/>
                                <span t-if="job.express" class="badge text-bg-dark ms-1">EXPRESS</span>
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="text-muted">Shelf</div>
                            <div class="ed-shelf fw-bolder" style="font-size: 4rem; line-height: 1;" t-esc="job.shelf or '—'"/>
                        </div>
                    </div>
                    <div t-if="job.tags.length" class="font-monospace small text-muted">Tags: <t t-esc="job.tags.join(', ')"/>
                    </div>
                    <div class="fs-4">
                        Amount due: <b class="ed-amount-due" t-att-class="isPaid ? 'text-success' : 'text-danger'" t-esc="formatCurrency(job.amount_due)"/>
                        <span t-if="job.credit_approved" class="badge text-bg-success ms-2">Credit approved</span>
                    </div>
                    <div t-if="isNotReady" class="alert alert-danger m-0 ed-not-ready">
                        Not ready yet (<t t-esc="job.state_label"/>). Promised: <t t-esc="formatDate(job.promised_on)"/>. It cannot be released.
                    </div>
                    <div t-elif="isClosed" class="alert alert-secondary m-0">This job is already closed.</div>
                    <div t-else="" class="d-flex flex-wrap gap-2">
                        <button t-if="isPaid" class="btn btn-success btn-lg ed-release" t-on-click="release">
                            <i class="fa fa-check me-1"/>Release
                        </button>
                        <t t-else="">
                            <button class="btn btn-primary btn-lg ed-take-payment" t-on-click="takePayment">
                                <i class="fa fa-money me-1"/>Take payment
                            </button>
                            <button class="btn btn-warning btn-lg ed-credit-release" t-on-click="creditRelease">
                                <i class="fa fa-key me-1"/>Manager approves credit
                            </button>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
