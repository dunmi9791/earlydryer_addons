<odoo>
    <record id="view_pos_pos_form_earlydryer" model="ir.ui.view">
        <field name="name">pos.order.form.earlydryer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="earlydryer_is_laundry" invisible="1"/>
                <button name="action_earlydryer_retry_job" type="object" string="Retry Job Creation"
                        class="btn-secondary"
                        invisible="not earlydryer_is_laundry or earlydryer_job_id or state not in ('paid', 'done')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not earlydryer_job_error">
                    <strong>Laundry job not created.</strong>
                    <field name="earlydryer_job_error" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='extra']" position="before">
                <page string="Laundry" name="earlydryer" invisible="not earlydryer_is_laundry and not earlydryer_settlement_job_ids">
                    <group>
                        <group>
                            <field name="earlydryer_job_id"/>
                            <field name="earlydryer_job_state"/>
                            <field name="earlydryer_express"/>
                            <field name="earlydryer_fulfilment"/>
                        </group>
                        <group>
                            <field name="earlydryer_promised_estimate"/>
                            <field name="earlydryer_customer_note"/>
                            <field name="earlydryer_settlement_job_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="lines" readonly="1">
                        <list>
                            <field name="full_product_name"/>
                            <field name="qty"/>
                            <field name="discount"/>
                            <field name="earlydryer_parent_line_id" string="Garment Line"/>
                            <field name="earlydryer_surcharge_id"/>
                            <field name="earlydryer_colour"/>
                            <field name="earlydryer_brand" optional="hide"/>
                            <field name="earlydryer_condition_note" optional="show"/>
                            <field name="earlydryer_tag_codes"/>
                            <field name="earlydryer_photo_count" optional="hide"/>
                            <field name="earlydryer_discount_approver_employee_id" optional="show"/>
                            <field name="earlydryer_settlement_job_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_earlydryer" model="ir.ui.view">
        <field name="name">pos.order.list.earlydryer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="earlydryer_job_id" optional="show"/>
                <field name="earlydryer_job_error" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="pos_order_action_earlydryer_job_errors" model="ir.actions.act_window">
        <field name="name">POS Orders without Laundry Job</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('earlydryer_job_error', '!=', False), ('earlydryer_job_id', '=', False)]</field>
    </record>
</odoo>
