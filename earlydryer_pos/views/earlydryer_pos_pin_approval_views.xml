<odoo>
    <record id="earlydryer_pos_pin_approval_view_list" model="ir.ui.view">
        <field name="name">earlydryer.pos.pin.approval.list</field>
        <field name="model">earlydryer.pos.pin.approval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="approval_type"/>
                <field name="employee_id"/>
                <field name="user_id" optional="show"/>
                <field name="cashier_employee_id"/>
                <field name="pos_config_id"/>
                <field name="pos_order_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="rule_id" optional="hide"/>
                <field name="request_id" optional="hide"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_pos_pin_approval_view_search" model="ir.ui.view">
        <field name="name">earlydryer.pos.pin.approval.search</field>
        <field name="model">earlydryer.pos.pin.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="cashier_employee_id"/>
                <field name="pos_config_id"/>
                <filter name="discount" string="Discounts" domain="[('approval_type', '=', 'discount')]"/>
                <filter name="credit" string="Credit" domain="[('approval_type', '=', 'credit')]"/>
                <group>
                    <filter name="group_employee" string="Approved By" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="earlydryer_pos_pin_approval_action" model="ir.actions.act_window">
        <field name="name">Till PIN Approvals</field>
        <field name="res_model">earlydryer.pos.pin.approval</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
