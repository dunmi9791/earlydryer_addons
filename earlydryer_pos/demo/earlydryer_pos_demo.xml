<odoo>
    <!-- DEMO ONLY: one laundry counter per plant, staff with PINs, discount
         rules and a few paid and partly paid intakes. -->

    <record id="partner_walk_in" model="res.partner">
        <field name="name">Walk-in Customer</field>
    </record>

    <!-- Payment methods: cash, card terminal, bank transfer, customer account -->
    <record id="journal_card_p1" model="account.journal">
        <field name="name">Card Plant 1</field>
        <field name="code">CRD1</field>
        <field name="type">bank</field>
    </record>
    <record id="journal_card_p2" model="account.journal">
        <field name="name">Card Plant 2</field>
        <field name="code">CRD2</field>
        <field name="type">bank</field>
    </record>
    <record id="journal_transfer" model="account.journal">
        <field name="name">Bank Transfers (POS)</field>
        <field name="code">BTRF</field>
        <field name="type">bank</field>
    </record>
    <record id="pos_payment_method_card_p1" model="pos.payment.method">
        <field name="name">Card Plant 1</field>
        <field name="journal_id" ref="journal_card_p1"/>
    </record>
    <record id="pos_payment_method_cash_p2" model="pos.payment.method">
        <field name="name">Cash Plant 2</field>
        <field name="journal_id" ref="earlydryer_base.journal_cash_plant_2"/>
    </record>
    <record id="pos_payment_method_card_p2" model="pos.payment.method">
        <field name="name">Card Plant 2</field>
        <field name="journal_id" ref="journal_card_p2"/>
    </record>
    <record id="pos_payment_method_transfer" model="pos.payment.method">
        <field name="name">Bank Transfer</field>
        <field name="journal_id" ref="journal_transfer"/>
    </record>
    <record id="pos_payment_method_account" model="pos.payment.method">
        <field name="name">Customer Account</field>
        <field name="split_transactions" eval="True"/>
    </record>

    <!-- Staff: PINs are demo values -->
    <record id="user_front_desk_p2" model="res.users">
        <field name="name">Demo Front Desk (P2)</field>
        <field name="login">ed_frontdesk_p2</field>
        <field name="password">ed_frontdesk_p2</field>
        <field name="group_ids" eval="[(6, 0, [ref('earlydryer_base.group_front_desk')])]"/>
        <field name="earlydryer_branch_ids" eval="[(6, 0, [ref('earlydryer_base.branch_plant_2')])]"/>
        <field name="earlydryer_branch_id" ref="earlydryer_base.branch_plant_2"/>
    </record>
    <record id="user_branch_manager_p2" model="res.users">
        <field name="name">Demo Branch Manager (P2)</field>
        <field name="login">ed_branchmgr_p2</field>
        <field name="password">ed_branchmgr_p2</field>
        <field name="group_ids" eval="[(6, 0, [ref('earlydryer_base.group_branch_manager')])]"/>
        <field name="earlydryer_branch_ids" eval="[(6, 0, [ref('earlydryer_base.branch_plant_2')])]"/>
        <field name="earlydryer_branch_id" ref="earlydryer_base.branch_plant_2"/>
    </record>
    <record id="earlydryer_laundry_order.employee_front_desk_p1" model="hr.employee">
        <field name="pin">1111</field>
    </record>
    <record id="earlydryer_laundry_order.employee_branch_manager_p1" model="hr.employee">
        <field name="pin">9999</field>
    </record>
    <record id="employee_front_desk_p2" model="hr.employee">
        <field name="name">Zainab Garba</field>
        <field name="job_title">Front Desk</field>
        <field name="user_id" ref="user_front_desk_p2"/>
        <field name="earlydryer_branch_id" ref="earlydryer_base.branch_plant_2"/>
        <field name="pin">2222</field>
    </record>
    <record id="employee_branch_manager_p2" model="hr.employee">
        <field name="name">Ifeanyi Okonkwo</field>
        <field name="job_title">Branch Manager</field>
        <field name="user_id" ref="user_branch_manager_p2"/>
        <field name="earlydryer_branch_id" ref="earlydryer_base.branch_plant_2"/>
        <field name="pin">8888</field>
    </record>
    <record id="earlydryer_base.branch_plant_2" model="earlydryer.branch">
        <field name="manager_id" ref="user_branch_manager_p2"/>
    </record>

    <!-- Discount limits: placeholders until Earlydryer decides (lowest
         sequence wins over the base demo rules) -->
    <record id="approval_rule_discount_front_desk" model="earlydryer.approval.rule">
        <field name="name">Till discount up to 5%: Front Desk (self-approved)</field>
        <field name="sequence">1</field>
        <field name="approval_type">discount</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="threshold_kind">percent</field>
        <field name="min_value">0</field>
        <field name="max_value">5</field>
        <field name="branch_ids" eval="[(6, 0, [ref('earlydryer_base.branch_plant_1'), ref('earlydryer_base.branch_plant_2')])]"/>
        <field name="approver_group_id" ref="earlydryer_base.group_front_desk"/>
        <field name="self_approve" eval="True"/>
    </record>
    <record id="approval_rule_discount_branch_manager" model="earlydryer.approval.rule">
        <field name="name">Till discount above 5%: Branch Manager (PIN)</field>
        <field name="sequence">2</field>
        <field name="approval_type">discount</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="threshold_kind">percent</field>
        <field name="min_value">5</field>
        <field name="max_value">0</field>
        <field name="branch_ids" eval="[(6, 0, [ref('earlydryer_base.branch_plant_1'), ref('earlydryer_base.branch_plant_2')])]"/>
        <field name="approver_group_id" ref="earlydryer_base.group_branch_manager"/>
    </record>

    <!-- Tills -->
    <record id="pos_config_counter_p2" model="pos.config">
        <field name="name">Plant 2 Counter</field>
        <field name="earlydryer_branch_id" ref="earlydryer_base.branch_plant_2"/>
        <field name="payment_method_ids" eval="[Command.set([ref('pos_payment_method_cash_p2')])]"/>
    </record>
    <function model="earlydryer.branch" name="action_earlydryer_sync_pos_pricelists"
              eval="[[ref('earlydryer_base.branch_plant_2')]]"/>
    <record id="earlydryer_service_catalog.pos_config_counter_p1" model="pos.config">
        <field name="module_pos_hr" eval="True"/>
        <field name="restrict_price_control" eval="True"/>
        <field name="payment_method_ids" eval="[Command.set([
            ref('earlydryer_service_catalog.pos_payment_method_cash_p1'),
            ref('pos_payment_method_card_p1'),
            ref('pos_payment_method_transfer'),
            ref('pos_payment_method_account')])]"/>
        <field name="earlydryer_enabled" eval="True"/>
        <field name="earlydryer_walkin_partner_id" ref="partner_walk_in"/>
        <field name="earlydryer_label_width_mm">50</field>
        <field name="earlydryer_label_height_mm">25</field>
    </record>
    <record id="pos_config_counter_p2" model="pos.config">
        <field name="module_pos_hr" eval="True"/>
        <field name="restrict_price_control" eval="True"/>
        <field name="payment_method_ids" eval="[Command.set([
            ref('pos_payment_method_cash_p2'),
            ref('pos_payment_method_card_p2'),
            ref('pos_payment_method_transfer'),
            ref('pos_payment_method_account')])]"/>
        <field name="earlydryer_enabled" eval="True"/>
        <field name="earlydryer_walkin_partner_id" ref="partner_walk_in"/>
        <field name="earlydryer_label_width_mm">60</field>
        <field name="earlydryer_label_height_mm">15</field>
    </record>
    <function model="pos.config" name="_earlydryer_top_up_tag_ranges"
              eval="[[ref('earlydryer_service_catalog.pos_config_counter_p1'), ref('pos_config_counter_p2')]]"/>

    <!-- Paid and partly paid intakes on the Plant 1 counter (session closed) -->
    <function model="pos.config" name="_earlydryer_load_demo_orders"
              eval="[[ref('earlydryer_service_catalog.pos_config_counter_p1')]]"/>
</odoo>
