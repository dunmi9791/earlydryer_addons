<odoo noupdate="1">
    <!-- Price and discount changes of POS lines after the sale (backend, sync
         updates). Confirmed by the post_init_hook, see hooks.py. Lines are
         created at every sale, so creation is not logged. -->
    <record id="auditlog_rule_pos_order_line" model="auditlog.rule">
        <field name="name">POS order lines (prices, discounts)</field>
        <field name="model_id" ref="point_of_sale.model_pos_order_line"/>
        <field name="log_type">fast</field>
        <field name="log_create" eval="False"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="log_read" eval="False"/>
        <field name="log_export_data" eval="False"/>
        <field name="capture_record" eval="False"/>
    </record>
</odoo>
