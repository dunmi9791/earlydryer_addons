<odoo>
    <template id="portal_my_home_pickups" name="Pickups" customize_show="True" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Pickups</t>
                <t t-set="url" t-value="'/my/pickups'"/>
                <t t-set="text">Follow, cancel or book laundry pickups</t>
                <t t-set="placeholder_count" t-value="'pickup_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_pickups" name="My Pickups">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="d-flex justify-content-between align-items-center my-3">
                <h3 class="mb-0">Pickups</h3>
                <a href="/pickup" class="btn btn-primary">Book a pickup</a>
            </div>
            <div t-if="not pickups" class="alert alert-info">You have no pickups yet.</div>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Pickup</th>
                        <th>When</th>
                        <th>Status</th>
                        <th class="text-end"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="pickups" t-as="pickup">
                        <td t-out="pickup['reference']"/>
                        <td t-out="pickup['slot_label']"/>
                        <td><span class="badge text-bg-light" t-out="pickup['state_label']"/></td>
                        <td class="text-end">
                            <a t-if="pickup['track_url']" t-att-href="pickup['track_url']">View</a>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
