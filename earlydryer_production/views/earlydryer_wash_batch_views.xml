<odoo>
    <record id="earlydryer_wash_batch_view_list" model="ir.ui.view">
        <field name="name">earlydryer.wash.batch.list</field>
        <field name="model">earlydryer.wash.batch</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'running'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="earlydryer_branch_id" optional="show" groups="earlydryer_base.group_all_branches"/>
                <field name="batch_type"/>
                <field name="machine_id"/>
                <field name="colour_group" optional="show"/>
                <field name="program" optional="show"/>
                <field name="item_count" string="Garments"/>
                <field name="load_weight_kg" optional="show"/>
                <field name="employee_id"/>
                <field name="started_on" optional="show"/>
                <field name="finished_on" optional="hide"/>
                <field name="duration_minutes" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"
                       decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_wash_batch_view_form" model="ir.ui.view">
        <field name="name">earlydryer.wash.batch.form</field>
        <field name="model">earlydryer.wash.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_suggest_items" type="object" string="Suggest Garments"
                            invisible="state != 'draft'" groups="earlydryer_base.group_production"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state != 'draft' or not id" groups="earlydryer_base.group_production"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary"
                            invisible="state != 'running'" groups="earlydryer_base.group_production"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled') or not id"
                            groups="earlydryer_base.group_production"/>
                    <button name="action_reset_draft" type="object" string="Back to Draft"
                            invisible="state != 'cancelled'" groups="earlydryer_base.group_production"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="earlydryer_branch_id" readonly="id" options="{'no_create': True}"/>
                            <field name="batch_type" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="machine_type_ids" invisible="1"/>
                            <field name="wait_state" invisible="1"/>
                            <field name="busy_item_ids" invisible="1"/>
                            <label for="machine_id"/>
                            <div class="o_row">
                                <field name="machine_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                                <field name="machine_status" widget="badge" invisible="not machine_id"
                                       decoration-success="machine_status == 'available'"
                                       decoration-warning="machine_status == 'in_use'"
                                       decoration-danger="machine_status == 'down'"/>
                            </div>
                            <field name="colour_group" readonly="state != 'draft'"/>
                            <field name="service_type_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}" readonly="state not in ('draft', 'running')"/>
                            <field name="program" placeholder="e.g. 40 °C cotton" readonly="state not in ('draft', 'running')"/>
                            <field name="require_load_weight" invisible="1"/>
                            <field name="load_weight_kg" required="require_load_weight and state == 'draft' and id"
                                   readonly="state not in ('draft', 'running')"/>
                            <field name="estimated_weight_kg" invisible="not estimated_weight_kg"/>
                            <field name="machine_capacity_kg" invisible="not machine_capacity_kg" string="Capacity (kg)"/>
                            <field name="suggest_count" invisible="state != 'draft'"/>
                            <field name="started_on" invisible="not started_on"/>
                            <field name="finished_on" invisible="not finished_on"/>
                            <field name="duration_minutes" invisible="not finished_on"/>
                        </group>
                    </group>
                    <group invisible="state != 'draft' or machine_status not in ('down', 'in_use')"
                           groups="earlydryer_base.group_branch_manager">
                        <field name="override_note" placeholder="Branch Manager: why start on this machine anyway"/>
                    </group>
                    <notebook>
                        <page string="Garments" name="items">
                            <field name="item_ids" readonly="state != 'draft'"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="job_id"/>
                                    <field name="tag_code"/>
                                    <field name="product_id"/>
                                    <field name="colour"/>
                                    <field name="colour_group"/>
                                    <field name="express" optional="show"/>
                                </list>
                            </field>
                            <group>
                                <field name="job_count" string="Jobs"/>
                                <field name="item_count" string="Garments"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="earlydryer_wash_batch_view_search" model="ir.ui.view">
        <field name="name">earlydryer.wash.batch.search</field>
        <field name="model">earlydryer.wash.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="machine_id"/>
                <field name="employee_id"/>
                <field name="item_ids" string="Job or Tag" filter_domain="['|', ('item_ids.job_id.name', 'ilike', self), ('item_ids.tag_code', 'ilike', self)]"/>
                <filter string="Open" name="open" domain="[('state', 'in', ('draft', 'running'))]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Wash" name="wash" domain="[('batch_type', '=', 'wash')]"/>
                <filter string="Dry" name="dry" domain="[('batch_type', '=', 'dry')]"/>
                <filter name="started_on" string="Started" date="started_on"/>
                <group>
                    <filter string="Machine" name="group_machine" context="{'group_by': 'machine_id'}"/>
                    <filter string="Run By" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Colour Group" name="group_colour" context="{'group_by': 'colour_group'}"/>
                    <filter string="Plant" name="group_branch" context="{'group_by': 'earlydryer_branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="earlydryer_wash_batch_action" model="ir.actions.act_window">
        <field name="name">Wash &amp; Dry Batches</field>
        <field name="res_model">earlydryer.wash.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a machine load</p>
            <p>Only plants with "Wash and Dry Batches" turned on use batches. Choose the machine,
               let Odoo suggest the waiting garments, start, then mark it done: the jobs whose
               garments have all been through move on.</p>
        </field>
    </record>
</odoo>
