<odoo>
    <record id="earlydryer_tablet_identification_view_list" model="ir.ui.view">
        <field name="name">earlydryer.tablet.identification.list</field>
        <field name="model">earlydryer.tablet.identification</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="result != 'ok'">
                <field name="date"/>
                <field name="earlydryer_branch_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="employee_id"/>
                <field name="method"/>
                <field name="result" widget="badge" decoration-success="result == 'ok'"
                       decoration-danger="result != 'ok'"/>
                <field name="last_activity" optional="hide"/>
                <field name="ended" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_tablet_identification_view_search" model="ir.ui.view">
        <field name="name">earlydryer.tablet.identification.search</field>
        <field name="model">earlydryer.tablet.identification</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="user_id"/>
                <filter string="Failed" name="failed" domain="[('result', '!=', 'ok')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter string="Tablet User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="earlydryer_tablet_identification_action" model="ir.actions.act_window">
        <field name="name">Tablet Sign-ins</field>
        <field name="res_model">earlydryer.tablet.identification</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
