<odoo>
    <record id="laundry_job_view_form_production" model="ir.ui.view">
        <field name="name">laundry.job.form.production</field>
        <field name="model">laundry.job</field>
        <field name="inherit_id" ref="earlydryer_laundry_order.laundry_job_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_move_wizard']" position="before">
                <button name="action_open_sort_wizard" type="object" string="Sort"
                        class="btn-primary" invisible="state != 'tagged'"
                        groups="earlydryer_base.group_front_desk,earlydryer_base.group_production"/>
            </xpath>
            <xpath expr="//group[@name='dates']" position="inside">
                <field name="unsorted_item_count" invisible="not unsorted_item_count or state not in ('received', 'tagged')"
                       decoration-warning="1"/>
                <field name="rework_item_count" invisible="not rework_item_count" decoration-warning="1"/>
            </xpath>
            <xpath expr="//field[@name='item_ids']/list/field[@name='colour']" position="after">
                <field name="colour_group" optional="show"/>
            </xpath>
            <xpath expr="//page[@name='stage_history']" position="after">
                <page string="QC Reworks" name="earlydryer_reworks" invisible="not rework_ids">
                    <field name="rework_ids">
                        <list>
                            <field name="date"/>
                            <field name="item_id"/>
                            <field name="reason_id"/>
                            <field name="is_damage"/>
                            <field name="to_state"/>
                            <field name="employee_id"/>
                            <field name="note"/>
                            <field name="photo" widget="image" options="{'size': [0, 32]}" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='stage_history']/field[@name='stage_log_ids']/list/field[@name='employee_id']" position="after">
                <field name="item_count" optional="show"/>
                <field name="source" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- QC queue: oldest first, express on top -->
    <record id="laundry_job_view_list_qc" model="ir.ui.view">
        <field name="name">laundry.job.list.qc</field>
        <field name="model">laundry.job</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="false" default_order="express desc, received_on asc, id asc"
                  decoration-danger="is_overdue">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="earlydryer_branch_id" optional="hide" groups="earlydryer_base.group_all_branches"/>
                <field name="express" widget="boolean_toggle" readonly="1"/>
                <field name="item_count" string="Items"/>
                <field name="rework_item_count" string="Reworked" optional="show"/>
                <field name="received_on"/>
                <field name="promised_on"/>
                <field name="is_overdue" column_invisible="True"/>
                <button name="action_open_qc_wizard" type="object" string="Check" icon="fa-check-square-o"
                        class="btn-primary" groups="earlydryer_base.group_qc"/>
            </list>
        </field>
    </record>

    <record id="laundry_job_action_qc" model="ir.actions.act_window">
        <field name="name">QC</field>
        <field name="res_model">laundry.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'qc')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('laundry_job_view_list_qc')}),
            Command.create({'view_mode': 'form', 'view_id': ref('earlydryer_laundry_order.laundry_job_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for QC</p>
        </field>
    </record>

    <record id="action_earlydryer_stage_board" model="ir.actions.client">
        <field name="name">Stage Board</field>
        <field name="tag">earlydryer_production.stage_board</field>
    </record>
</odoo>
