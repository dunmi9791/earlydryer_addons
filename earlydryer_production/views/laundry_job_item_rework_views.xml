<odoo>
    <record id="laundry_job_item_rework_view_list" model="ir.ui.view">
        <field name="name">laundry.job.item.rework.list</field>
        <field name="model">laundry.job.item.rework</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="is_damage">
                <field name="date"/>
                <field name="job_id"/>
                <field name="item_id"/>
                <field name="earlydryer_branch_id" optional="show"/>
                <field name="reason_id"/>
                <field name="is_damage"/>
                <field name="to_state"/>
                <field name="employee_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="photo" widget="image" options="{'size': [0, 32]}" optional="show"/>
            </list>
        </field>
    </record>

    <record id="laundry_job_item_rework_view_form" model="ir.ui.view">
        <field name="name">laundry.job.item.rework.form</field>
        <field name="model">laundry.job.item.rework</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="item_id"/>
                            <field name="reason_id"/>
                            <field name="is_damage"/>
                            <field name="from_state"/>
                            <field name="to_state"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                            <field name="earlydryer_branch_id"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <field name="photo" widget="image"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="laundry_job_item_rework_view_search" model="ir.ui.view">
        <field name="name">laundry.job.item.rework.search</field>
        <field name="model">laundry.job.item.rework</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="reason_id"/>
                <field name="employee_id"/>
                <filter string="Damage" name="damage" domain="[('is_damage', '=', True)]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter string="Reason" name="group_reason" context="{'group_by': 'reason_id'}"/>
                    <filter string="Checked By" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Plant" name="group_branch" context="{'group_by': 'earlydryer_branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="laundry_job_item_rework_view_pivot" model="ir.ui.view">
        <field name="name">laundry.job.item.rework.pivot</field>
        <field name="model">laundry.job.item.rework</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="reason_id" type="row"/>
                <field name="date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="laundry_job_item_rework_action" model="ir.actions.act_window">
        <field name="name">QC Reworks</field>
        <field name="res_model">laundry.job.item.rework</field>
        <field name="view_mode">list,pivot,form</field>
    </record>
</odoo>
