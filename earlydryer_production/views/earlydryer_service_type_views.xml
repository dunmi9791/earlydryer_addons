<odoo>
    <record id="earlydryer_service_type_view_form_production" model="ir.ui.view">
        <field name="name">earlydryer.service.type.form.production</field>
        <field name="model">earlydryer.service.type</field>
        <field name="inherit_id" ref="earlydryer_service_catalog.earlydryer_service_type_view_form"/>
        <field name="arch" type="xml">
            <field name="requires_tag" position="before">
                <field name="default_colour_group"/>
            </field>
        </field>
    </record>

    <record id="earlydryer_service_type_view_list_production" model="ir.ui.view">
        <field name="name">earlydryer.service.type.list.production</field>
        <field name="model">earlydryer.service.type</field>
        <field name="inherit_id" ref="earlydryer_service_catalog.earlydryer_service_type_view_list"/>
        <field name="arch" type="xml">
            <field name="requires_tag" position="after">
                <field name="default_colour_group" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
