<odoo>
    <record id="laundry_job_stage_log_view_list_production" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.list.production</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="inherit_id" ref="earlydryer_laundry_order.laundry_job_stage_log_view_list"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="item_count" optional="show" sum="Items"/>
                <field name="source" optional="show"/>
            </field>
        </field>
    </record>

    <record id="laundry_job_stage_log_view_search_production" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.search.production</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="inherit_id" ref="earlydryer_laundry_order.laundry_job_stage_log_view_search"/>
        <field name="arch" type="xml">
            <filter name="production" position="after">
                <filter name="no_employee" string="Without Employee" domain="[('employee_id', '=', False)]"/>
                <filter name="today" string="Today"
                        domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
            </filter>
            <filter name="group_user" position="after">
                <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
            </filter>
        </field>
    </record>

    <record id="laundry_job_stage_log_view_pivot_productivity" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.pivot.productivity</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Stage Productivity" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" interval="day" type="row"/>
                <field name="to_state" type="col"/>
                <field name="item_count" type="measure"/>
                <field name="move_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="laundry_job_stage_log_view_graph_productivity" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.graph.productivity</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <graph string="Stage Productivity" type="bar" stacked="1" sample="1">
                <field name="employee_id"/>
                <field name="to_state"/>
                <field name="item_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="laundry_job_stage_log_action_productivity" model="ir.actions.act_window">
        <field name="name">Stage Productivity</field>
        <field name="res_model">laundry.job.stage.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('to_state', 'in', ('sorted', 'washed', 'dried', 'ironed', 'qc', 'packed'))]</field>
        <field name="context">{'search_default_date': 1}</field>
        <field name="group_ids" eval="[(4, ref('earlydryer_base.group_branch_manager'))]"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('laundry_job_stage_log_view_pivot_productivity')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('laundry_job_stage_log_view_graph_productivity')}),
            Command.create({'view_mode': 'list', 'view_id': ref('earlydryer_laundry_order.laundry_job_stage_log_view_list')})]"/>
    </record>

    <record id="laundry_job_stage_log_action_no_employee" model="ir.actions.act_window">
        <field name="name">Moves without Employee</field>
        <field name="res_model">laundry.job.stage.log</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('to_state', 'in', ('sorted', 'washed', 'dried', 'ironed', 'qc', 'packed')), ('employee_id', '=', False)]</field>
        <field name="group_ids" eval="[(4, ref('earlydryer_base.group_branch_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every production move names who did the work</p>
            <p>Moves to a production stage without an employee show up here so gaps can be fixed at the source.</p>
        </field>
    </record>
</odoo>
