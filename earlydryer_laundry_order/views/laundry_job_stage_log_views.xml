<odoo>
    <record id="laundry_job_stage_log_view_list" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.list</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="job_id"/>
                <field name="earlydryer_branch_id" optional="show"/>
                <field name="from_state"/>
                <field name="to_state"/>
                <field name="employee_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="duration_hours" widget="float_time" optional="show"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="laundry_job_stage_log_view_pivot" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.pivot</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="employee_id" type="row"/>
                <field name="to_state" type="col"/>
                <field name="duration_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="laundry_job_stage_log_view_graph" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.graph</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="to_state"/>
                <field name="duration_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="laundry_job_stage_log_view_search" model="ir.ui.view">
        <field name="name">laundry.job.stage.log.search</field>
        <field name="model">laundry.job.stage.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="to_state"/>
                <filter name="date" string="Date" date="date"/>
                <filter name="production" string="Production Stages"
                        domain="[('to_state', 'in', ('sorted', 'washed', 'dried', 'ironed', 'qc', 'packed'))]"/>
                <group>
                    <filter name="group_employee" string="Done By" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_to_state" string="Stage" context="{'group_by': 'to_state'}"/>
                    <filter name="group_branch" string="Plant" context="{'group_by': 'earlydryer_branch_id'}"/>
                    <filter name="group_user" string="Recorded By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="laundry_job_stage_log_action" model="ir.actions.act_window">
        <field name="name">Stage Log</field>
        <field name="res_model">laundry.job.stage.log</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="laundry_job_stage_log_view_search"/>
    </record>
</odoo>
