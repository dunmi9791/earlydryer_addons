<odoo>
    <record id="laundry_job_request_wizard_view_form" model="ir.ui.view">
        <field name="name">laundry.job.request.wizard.form</field>
        <field name="model">laundry.job.request.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="job_id" readonly="1"/>
                    <field name="request_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="description" placeholder="What did the customer ask for?"/>
                </group>
                <p class="text-muted">
                    A To Do is scheduled for the plant's Branch Manager, who changes or
                    cancels the job.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Send to Manager"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
