<odoo>
    <record id="laundry_job_move_wizard_view_form" model="ir.ui.view">
        <field name="name">laundry.job.move.wizard.form</field>
        <field name="model">laundry.job.move.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="branch_ids" invisible="1"/>
                <field name="employee_required" invisible="1"/>
                <group>
                    <field name="job_ids" widget="many2many_tags" readonly="1"/>
                    <field name="target_state"/>
                    <field name="employee_id" required="employee_required"
                           options="{'no_create': True}"
                           domain="['|', ('earlydryer_branch_id', '=', False), ('earlydryer_branch_id', 'in', branch_ids)]"/>
                    <field name="item_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="note" required="target_state == 'cancelled'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="laundry_job_move_wizard_action" model="ir.actions.act_window">
        <field name="name">Move to Stage</field>
        <field name="res_model">laundry.job.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_laundry_job"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="context">{'default_job_ids': active_ids}</field>
    </record>
</odoo>
