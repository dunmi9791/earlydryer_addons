<odoo>
    <record id="earlydryer_service_type_view_list" model="ir.ui.view">
        <field name="name">earlydryer.service.type.list</field>
        <field name="model">earlydryer.service.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="standard_turnaround_hours"/>
                <field name="express_available"/>
                <field name="express_turnaround_hours" invisible="not express_available"/>
                <field name="express_surcharge_kind" invisible="not express_available" optional="show"/>
                <field name="express_surcharge_value" invisible="not express_available" optional="show"/>
                <field name="requires_tag" optional="hide"/>
                <field name="allowed_category_ids" widget="many2many_tags" optional="hide"/>
                <field name="product_count" optional="show"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_service_type_view_form" model="ir.ui.view">
        <field name="name">earlydryer.service.type.form</field>
        <field name="model">earlydryer.service.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-tags">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Wash &amp; Iron"/></h1>
                    </div>
                    <group>
                        <group string="Service">
                            <field name="code" placeholder="e.g. WI"/>
                            <field name="standard_turnaround_hours"/>
                            <field name="requires_tag"/>
                            <field name="pos_category_id"/>
                        </group>
                        <group string="Express">
                            <field name="express_available"/>
                            <field name="express_turnaround_hours" invisible="not express_available" required="express_available"/>
                            <field name="express_surcharge_kind" invisible="not express_available" required="express_available"/>
                            <field name="express_surcharge_value" invisible="not express_available"/>
                        </group>
                    </group>
                    <group string="Allowed Garment Categories">
                        <field name="allowed_category_ids" widget="many2many_tags" nolabel="1" colspan="2"
                               placeholder="Every category"/>
                    </group>
                    <field name="description" placeholder="Description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="earlydryer_service_type_view_search" model="ir.ui.view">
        <field name="name">earlydryer.service.type.search</field>
        <field name="model">earlydryer.service.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <filter string="Express Available" name="express" domain="[('express_available', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="earlydryer_service_type_action" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">earlydryer.service.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
