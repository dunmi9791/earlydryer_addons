<odoo>
    <record id="earlydryer_surcharge_view_list" model="ir.ui.view">
        <field name="name">earlydryer.surcharge.list</field>
        <field name="model">earlydryer.surcharge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="compute_mode"/>
                <field name="percent" invisible="compute_mode != 'percent'"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" widget="monetary" invisible="compute_mode != 'fixed'"/>
                <field name="service_type_ids" widget="many2many_tags" optional="show"/>
                <field name="category_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="earlydryer_surcharge_view_form" model="ir.ui.view">
        <field name="name">earlydryer.surcharge.form</field>
        <field name="model">earlydryer.surcharge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Silk"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. SILK"/>
                            <field name="kind"/>
                            <field name="compute_mode"/>
                            <field name="percent" invisible="compute_mode != 'percent'" required="compute_mode == 'percent'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" widget="monetary" invisible="compute_mode != 'fixed' or not product_id"/>
                        </group>
                        <group>
                            <field name="product_id" placeholder="Created automatically"
                                   context="{'default_earlydryer_kind': 'surcharge', 'default_type': 'service'}"/>
                            <field name="service_type_ids" widget="many2many_tags" placeholder="Every service"/>
                            <field name="category_ids" widget="many2many_tags" placeholder="Every garment"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        A surcharge is always invoiced as its own line, linked to the garment line.
                        Fixed surcharges take the price of their product in the applicable price list
                        (add price list items to vary it by plant or channel).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="earlydryer_surcharge_view_search" model="ir.ui.view">
        <field name="name">earlydryer.surcharge.search</field>
        <field name="model">earlydryer.surcharge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Kind" name="group_kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="earlydryer_surcharge_action" model="ir.actions.act_window">
        <field name="name">Surcharges</field>
        <field name="res_model">earlydryer.surcharge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
