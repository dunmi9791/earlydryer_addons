<odoo>
    <record id="earlydryer_pricelist_version_wizard_view_form" model="ir.ui.view">
        <field name="name">earlydryer.pricelist.version.wizard.form</field>
        <field name="model">earlydryer.pricelist.version.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="pricelist_id" readonly="1" force_save="1"/>
                        <field name="effective_date"/>
                        <field name="item_count"/>
                    </group>
                    <group>
                        <field name="percent_change"/>
                        <field name="rounding" placeholder="e.g. 50"/>
                    </group>
                </group>
                <p class="text-muted">
                    The prices valid on the effective date are copied from that date (with the change applied
                    to fixed prices); the current prices end the day before. Past prices are never edited.
                </p>
                <footer>
                    <button name="action_create_version" type="object" string="Create Version" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
