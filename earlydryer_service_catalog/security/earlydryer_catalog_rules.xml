<odoo>
    <!--
        Prices are managed by Earlydryer Management only. Core groups held by
        lower roles (e.g. point_of_sale.group_pos_manager via Branch Manager,
        stock.group_stock_manager, product.group_product_manager) give write
        access to products and price lists; these rules restrict create, write
        and delete of Earlydryer laundry / surcharge / express products and
        Earlydryer price lists to Management. Reading is not restricted.
    -->
    <record id="product_template_rule_earlydryer_restrict" model="ir.rule">
        <field name="name">Earlydryer service products: Management only (others)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">['|', ('earlydryer_kind', '=', False), ('earlydryer_kind', '=', 'retail')]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_template_rule_earlydryer_management" model="ir.rule">
        <field name="name">Earlydryer service products: Management</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('earlydryer_base.group_management'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_product_rule_earlydryer_restrict" model="ir.rule">
        <field name="name">Earlydryer service product variants: Management only (others)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">['|', ('earlydryer_kind', '=', False), ('earlydryer_kind', '=', 'retail')]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_product_rule_earlydryer_management" model="ir.rule">
        <field name="name">Earlydryer service product variants: Management</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('earlydryer_base.group_management'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_pricelist_rule_earlydryer_restrict" model="ir.rule">
        <field name="name">Earlydryer price lists: Management only (others)</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">[('earlydryer_channel', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_pricelist_rule_earlydryer_management" model="ir.rule">
        <field name="name">Earlydryer price lists: Management</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('earlydryer_base.group_management'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_pricelist_item_rule_earlydryer_restrict" model="ir.rule">
        <field name="name">Earlydryer price list items: Management only (others)</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">[('pricelist_id.earlydryer_channel', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="product_pricelist_item_rule_earlydryer_management" model="ir.rule">
        <field name="name">Earlydryer price list items: Management</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('earlydryer_base.group_management'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
</odoo>
